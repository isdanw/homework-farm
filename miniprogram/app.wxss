/**
 * app.wxss —— 全局样式
 * 设计规范：Q 版低幼卡通 + 柔和马卡龙配色
 *   主色：浅蓝 #BFE6FF / 嫩绿 #A8E6A1 / 米白 #FFF9F0 / 点缀嫩粉 #FFC9DC
 *   字号整体放大（正文 30rpx 起，标题 40rpx+），按钮点击区 ≥ 88rpx（≈44px）
 */
page {
  --c-blue: #BFE6FF;
  --c-blue-deep: #3FA9F5;
  --c-green: #A8E6A1;
  --c-green-deep: #5FBF6B;
  --c-pink: #FFC9DC;
  --c-pink-deep: #FF8FAE;
  --c-cream: #FFF9F0;
  --c-yellow: #FFE29A;
  --c-yellow-deep: #F5B740;
  --c-text: #4A4A4A;
  --c-sub: #8A8A8A;
  --c-danger: #FF7A7A;
  --radius: 28rpx;

  background: var(--c-cream);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

/* 页面容器：底部给自定义 tabBar 让位 + iPhone 安全区 */
.page-wrap {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(200rpx + env(safe-area-inset-bottom)) 24rpx;
  box-sizing: border-box;
}

/* ---------------- 通用卡片 ---------------- */
.card {
  background: #fff;
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(150, 180, 210, 0.14);
}
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.card-title .dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--c-blue-deep); margin-right: 14rpx;
}
.muted { color: var(--c-sub); font-size: 26rpx; }

/* ---------------- 通用按钮（大按钮，孩子好点） ---------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 34rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: var(--c-blue-deep);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08);
}
.btn:active { transform: translateY(3rpx); box-shadow: none; }
.btn-green { background: var(--c-green-deep); }
.btn-pink { background: var(--c-pink-deep); }
.btn-yellow { background: var(--c-yellow-deep); }
.btn-gray { background: #C9D3DC; }
.btn-line {
  background: #fff; color: var(--c-blue-deep);
  border: 3rpx solid var(--c-blue);
}
.btn-block { display: flex; width: 100%; }
.btn-sm { min-height: 70rpx; font-size: 28rpx; padding: 0 24rpx; }

/* ---------------- 顶部标题条 ---------------- */
.page-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10rpx 6rpx 22rpx 6rpx;
}
.page-head .t {
  font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx;
}
.page-head .s { font-size: 26rpx; color: var(--c-sub); }

/* ---------------- 学科色 ---------------- */
.sub-chinese { background: #FFB3C6; }
.sub-math    { background: #9AD5FF; }
.sub-english { background: #A8E6A1; }
.txt-chinese { color: #FF8FAE; }
.txt-math    { color: #5FB6F5; }
.txt-english { color: #6FCF7C; }

/* 学科小圆标 */
.sub-badge {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 800; font-size: 32rpx;
  box-shadow: inset 0 -6rpx 0 rgba(0,0,0,0.06);
}

/* ---------------- 资源条（金币/阳光等） ---------------- */
.res-bar { display: flex; gap: 14rpx; flex-wrap: wrap; }
.res-item {
  display: flex; align-items: center; gap: 8rpx;
  background: #fff; border-radius: 34rpx;
  padding: 10rpx 20rpx; font-size: 28rpx; font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(150,180,210,.16);
}

/* 金币图标（纯 CSS 画） */
.ic-coin {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFE79A, #F5B740);
  border: 3rpx solid #E09A18; box-sizing: border-box;
}
/* 阳光图标 */
.ic-sun {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFF3B0, #FFC94D);
  box-shadow: 0 0 0 6rpx rgba(255,201,77,.28);
}
/* 种子图标 */
.ic-seed {
  width: 30rpx; height: 34rpx; border-radius: 50% 50% 46% 46%;
  background: linear-gradient(180deg, #C9A06A, #8B5E34);
}
/* 杀虫剂图标 */
.ic-spray {
  width: 28rpx; height: 36rpx; border-radius: 8rpx;
  background: linear-gradient(180deg, #A8E6A1, #5FBF6B);
  position: relative;
}
.ic-spray::after {
  content: ''; position: absolute; top: -10rpx; left: 8rpx;
  width: 12rpx; height: 12rpx; background: #5FBF6B; border-radius: 4rpx;
}
/* 护盾图标 */
.ic-shield {
  width: 32rpx; height: 36rpx;
  background: linear-gradient(180deg, #BFE6FF, #3FA9F5);
  border-radius: 8rpx 8rpx 50% 50%;
}

/* ---------------- 弹窗 ---------------- */
.mask {
  position: fixed; inset: 0; background: rgba(60, 70, 90, .45);
  z-index: 900; display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
}
.dialog {
  width: 100%; max-width: 620rpx; background: #fff;
  border-radius: 36rpx; padding: 40rpx 32rpx 32rpx;
  text-align: center; animation: pop .28s cubic-bezier(.2,1.3,.5,1);
  max-height: 78vh; overflow-y: auto;
}
.dialog .d-title { font-size: 40rpx; font-weight: 800; margin-bottom: 16rpx; }
.dialog .d-text { font-size: 30rpx; color: #6A6A6A; line-height: 1.7; }
.dialog .d-btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.dialog .d-btns .btn { flex: 1; }
@keyframes pop {
  0% { transform: scale(.7); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* ---------------- 输入 ---------------- */
.input, .textarea {
  width: 100%; box-sizing: border-box;
  background: #F6F9FC; border-radius: 20rpx;
  padding: 20rpx 24rpx; font-size: 32rpx;  /* ≥16px 防止 iOS 缩放 */
  margin-bottom: 20rpx;
}
.textarea { min-height: 140rpx; }

/* ---------------- 进度条 ---------------- */
.bar { height: 24rpx; border-radius: 12rpx; background: #EDF3F8; overflow: hidden; }
.bar .fill {
  height: 100%; border-radius: 12rpx;
  background: linear-gradient(90deg, #A8E6A1, #5FBF6B);
  transition: width .5s ease;
}

/* 空状态 */
.empty { text-align: center; padding: 60rpx 0; color: var(--c-sub); font-size: 28rpx; }

/* ================= 学习模块通用：子导航 / 选项 / 网格 ================= */
.lnav { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.lnav .pill {
  flex: 1; text-align: center; padding: 14rpx 4rpx; border-radius: 20rpx;
  background: #fff; color: var(--c-sub); font-size: 30rpx; font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(150,180,210,.16); border: 3rpx solid transparent;
}
.lnav .pill.on { border-color: var(--c-blue); color: var(--c-blue-deep); font-weight: 800; background: #F2FAFF; }
.lpanel { display: none; }
.lpanel.on { display: block; animation: fade .2s ease; }
@keyframes fade { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: none; } }

/* 大选项（答题用） */
.opt { display: flex; gap: 14rpx; }
.opt .o {
  flex: 1; min-height: 84rpx; border-radius: 26rpx; background: #FFEFD6;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 800; color: var(--c-text);
  box-shadow: 0 6rpx 0 rgba(0,0,0,.08);
}
.opt .o:active { transform: translateY(3rpx); box-shadow: none; }
.opt .o.right { background: var(--c-green); color: #fff; }
.opt .o.wrong { background: var(--c-pink); color: #fff; animation: shake .4s; }
@keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-8rpx); } 75% { transform: translateX(8rpx); } }

/* 图形 / 单词 卡片网格 */
.grid3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; }
.tile { background: #fff; border-radius: 22rpx; box-shadow: 0 4rpx 14rpx rgba(150,180,210,.16); padding: 18rpx 8rpx; text-align: center; }
.tile .ic { font-size: 56rpx; }
.tile .nm { font-size: 26rpx; margin-top: 6rpx; color: var(--c-sub); }

/* 字母网格 */
.abc { display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; }
.abc .L {
  background: #fff; border-radius: 20rpx; box-shadow: 0 4rpx 14rpx rgba(150,180,210,.16);
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 800; color: var(--c-blue-deep); border: 3rpx solid transparent;
}
.abc .L.on { border-color: var(--c-yellow-deep); background: #FFF6DD; }
.abc .L small { display: block; font-size: 22rpx; color: var(--c-sub); font-weight: 400; }

/* 完成今日练习 底部条 */
.finish-bar { margin-top: 10rpx; }
