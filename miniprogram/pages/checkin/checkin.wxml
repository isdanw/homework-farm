<view class="page-wrap">

  <view class="page-head">
    <view>
      <view class="t">每日打卡</view>
      <view class="s">{{dateText}} · 今天完成 {{doneNum}}/3 科</view>
    </view>
  </view>

  <!-- 今晚农场预告：没写完就会挨罚（联动提示） -->
  <view class="forecast {{forecast.danger ? 'bad' : 'good'}}" bindtap="goFarm">
    <view class="fx-icon">
      <!-- 危险时显示小狗熊头，安全时显示太阳 -->
      <view wx:if="{{forecast.danger}}" class="mini-bear">
        <view class="ear l"></view><view class="ear r"></view>
        <view class="face"><view class="eye l"></view><view class="eye r"></view><view class="nose"></view></view>
      </view>
      <view wx:else class="mini-sun"></view>
    </view>
    <view class="fx-text">{{forecast.text}}</view>
  </view>

  <!-- 用时选择 -->
  <view class="card">
    <view class="card-title"><view class="dot"></view>这次写了多久？</view>
    <view class="min-row">
      <view wx:for="{{minuteOptions}}" wx:key="*this"
            class="min-chip {{pickMinutes === item ? 'on' : ''}}"
            data-m="{{item}}" bindtap="pickMinute">{{item}} 分钟</view>
    </view>
    <view class="muted">先选用时，再点下面对应科目的「我完成啦」</view>
  </view>

  <!-- 三科大卡片 -->
  <view wx:for="{{cards}}" wx:key="key" class="card hw-card {{item.done ? 'done' : ''}}">
    <view class="hw-top">
      <view class="sub-badge big" style="background:{{item.color}}">{{item.icon}}</view>
      <view class="hw-info">
        <view class="hw-name">{{item.name}}任务</view>
        <view class="hw-state" wx:if="{{item.done}}">已完成 · {{item.timeText}} · 用时 {{item.minutes}} 分钟</view>
        <view class="hw-state warn" wx:else>还没打卡，完成后可领 1 阳光 + 1 {{item.seedName}}</view>
      </view>
    </view>

    <view wx:if="{{item.note}}" class="hw-note">备注：{{item.note}}</view>

    <view class="hw-btns">
      <view wx:if="{{!item.done}}" class="btn btn-block btn-green big-btn" data-key="{{item.key}}" bindtap="doCheckin">我完成啦！</view>
      <block wx:else>
        <view class="btn btn-sm btn-line" data-key="{{item.key}}" bindtap="openNote">写备注</view>
        <view class="btn btn-sm btn-gray" data-key="{{item.key}}" bindtap="undoCheckin">撤销打卡</view>
      </block>
    </view>
  </view>

  <!-- 近 7 天 -->
  <view class="card">
    <view class="card-title"><view class="dot" style="background:#F5B740"></view>最近 7 天打卡</view>
    <view class="week-row">
      <view wx:for="{{week}}" wx:key="key" class="wk">
        <view class="wk-bars">
          <view class="wk-b {{item.num >= 1 ? 'f' : ''}}"></view>
          <view class="wk-b {{item.num >= 2 ? 'f' : ''}}"></view>
          <view class="wk-b {{item.num >= 3 ? 'f' : ''}}"></view>
        </view>
        <view class="wk-d {{item.isToday ? 'today' : ''}}">{{item.isToday ? '今天' : item.label}}</view>
      </view>
    </view>
  </view>
</view>

<!-- ============ 奖励弹窗 ============ -->
<view wx:if="{{reward}}" class="mask" bindtap="closeReward">
  <view class="dialog reward-dialog" catchtap="">
    <view class="rw-burst">
      <view class="ray" wx:for="{{[0,1,2,3,4,5,6,7]}}" wx:key="*this" style="transform:rotate({{item*45}}deg)"></view>
      <view class="rw-sun"></view>
    </view>
    <view class="d-title">{{reward.allDone ? '三科全部完成！超级棒！' : reward.subName + '任务完成啦！'}}</view>
    <view class="gain-row">
      <view class="gain"><view class="ic-sun"></view><text>阳光 +{{reward.sun}}</text></view>
      <view class="gain"><view class="ic-seed"></view><text>{{reward.seedName}} +{{reward.seed}}</text></view>
      <view wx:if="{{reward.coin > 0}}" class="gain"><view class="ic-coin"></view><text>金币 +{{reward.coin}}</text></view>
      <view wx:if="{{reward.pesticide > 0}}" class="gain"><view class="ic-spray"></view><text>杀虫剂 +{{reward.pesticide}}</text></view>
    </view>
    <view class="d-text" wx:if="{{reward.pesticide > 0}}">补齐任务奖励杀虫剂！快去农场赶走小狗熊，把植物治好～</view>
    <view class="d-text" wx:elif="{{reward.allDone}}">今晚农场很安全，小狗熊不敢来啦，去种下你的新种子吧！</view>
    <view class="d-text" wx:else>解锁了新的{{reward.seedName}}，去农场种下它吧～</view>
    <view class="d-btns">
      <view class="btn btn-gray" bindtap="closeReward">继续做任务</view>
      <view class="btn btn-green" bindtap="goFarmFromReward">去农场种下</view>
    </view>
  </view>
</view>

<!-- 备注弹窗 -->
<view wx:if="{{editing}}" class="mask" bindtap="closeNote">
  <view class="dialog" catchtap="">
    <view class="d-title">今天的备注</view>
    <textarea class="textarea" placeholder="例如：朗读课文 2 遍，妈妈已签字" value="{{noteText}}" bindinput="onNoteInput" maxlength="120" />
    <view class="d-btns">
      <view class="btn btn-gray" bindtap="closeNote">取消</view>
      <view class="btn btn-green" bindtap="saveNote">保存</view>
    </view>
  </view>
</view>
