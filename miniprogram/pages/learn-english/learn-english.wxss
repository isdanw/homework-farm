/* 英语启蒙模块样式 */
.tip { font-size: 24rpx; color: var(--c-sub); line-height: 1.6; margin: 16rpx 6rpx; }
.flip-mt { margin-top: 22rpx; }

/* 详情卡（字母 / 单词） */
.detail { background: #fff; border-radius: var(--radius); box-shadow: 0 8rpx 24rpx rgba(150,180,210,.16); padding: 28rpx; text-align: center; margin-top: 18rpx; }
.d-big { font-size: 140rpx; font-weight: 800; color: var(--c-blue-deep); line-height: 1; }
.d-pic { font-size: 90rpx; }
.d-pic.big { font-size: 130rpx; }
.d-word { font-size: 52rpx; font-weight: 800; color: var(--c-green-deep); margin: 8rpx 0; }
.play { display: inline-flex; align-items: center; gap: 8rpx; margin-top: 10rpx; background: var(--c-green-deep); color: #fff; padding: 12rpx 26rpx; border-radius: 30rpx; font-size: 28rpx; }

/* 跟读 */
.read { background: #fff; border-radius: var(--radius); box-shadow: 0 8rpx 24rpx rgba(150,180,210,.16); padding: 32rpx; text-align: center; }
.mic { width: 130rpx; height: 130rpx; border-radius: 50%; background: var(--c-pink-deep); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 60rpx; margin: 18rpx auto 6rpx; box-shadow: 0 8rpx 0 #e05a86; }
.mic.rec { background: var(--c-pink); animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }
.mic-tip { font-size: 26rpx; color: var(--c-sub); }
.score { margin-top: 18rpx; }
.score-tip { font-size: 26rpx; color: var(--c-text); margin-bottom: 10rpx; }
.stars-row { display: flex; justify-content: center; gap: 16rpx; }
.star { font-size: 56rpx; }
