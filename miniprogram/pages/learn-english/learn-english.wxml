<view class="page-wrap">
  <view class="page-head">
    <view class="t">🔠 英语启蒙</view>
    <view class="res-bar"><view class="res-item"><view class="ic-sun"></view>⭐ {{stars}}</view></view>
  </view>

  <view class="lnav">
    <view class="pill {{tab===0?'on':''}}" data-i="0" bindtap="switchTab">字母认知</view>
    <view class="pill {{tab===1?'on':''}}" data-i="1" bindtap="switchTab">单词卡片</view>
    <view class="pill {{tab===2?'on':''}}" data-i="2" bindtap="switchTab">简单跟读</view>
  </view>

  <!-- ① 字母认知 -->
  <view class="lpanel {{tab===0?'on':''}}">
    <view class="abc">
      <view wx:for="{{abcList}}" wx:key="l" class="L {{abcSel && abcSel.l===item.l ? 'on' : ''}}" data-i="{{index}}" bindtap="tapLetter">
        {{item.l}}<small>{{item.w}}</small>
      </view>
    </view>
    <view wx:if="{{abcSel}}" class="detail">
      <view class="d-big">{{abcSel.l}}</view>
      <view class="d-pic">{{abcSel.e}}</view>
      <view class="d-word">{{abcSel.w}}</view>
      <view class="play" bindtap="playLetter">🔊 点我听发音</view>
    </view>
    <view class="tip">点一个字母，看它的好朋友单词 👆 一共 26 个字母。</view>
  </view>

  <!-- ② 单词图文卡 -->
  <view class="lpanel {{tab===1?'on':''}}">
    <view class="grid3">
      <view wx:for="{{words}}" wx:key="w" class="tile" data-i="{{index}}" bindtap="tapWord">
        <view class="ic">{{item.e}}</view>
        <view class="nm">{{item.w}}</view>
      </view>
    </view>
    <view wx:if="{{wordSel}}" class="detail">
      <view class="d-pic big">{{wordSel.e}}</view>
      <view class="d-word">{{wordSel.w}}</view>
      <view class="play" bindtap="playWord">🔊 点我听单词</view>
    </view>
    <view class="tip">图文单词卡：大图 + 大单词，点图听读音、点字看拼写。计划 30–40 张基础词。</view>
  </view>

  <!-- ③ 简单跟读 -->
  <view class="lpanel {{tab===2?'on':''}}">
    <view class="read">
      <view class="d-pic big">{{readList[readI].e}}</view>
      <view class="d-word">{{readList[readI].w}}</view>
      <view class="flip center">
        <view class="btn btn-line" bindtap="playRead">🔊 先听一听</view>
        <view class="mic {{reading ? 'rec' : ''}}" bindtap="toggleRead">{{reading ? '✅' : '🎤'}}</view>
      </view>
      <view class="mic-tip">{{reading ? '正在跟读，读完点一下完成' : '先听示范，再点麦克风大声跟读'}}</view>
      <view wx:if="{{showScore}}" class="score">
        <view class="score-tip">请家长打分：</view>
        <view class="stars-row">
          <view class="star" data-n="1" bindtap="scoreRead">⭐</view>
          <view class="star" data-n="2" bindtap="scoreRead">⭐</view>
          <view class="star" data-n="3" bindtap="scoreRead">⭐</view>
        </view>
      </view>
    </view>
    <view class="btn btn-yellow flip-mt" bindtap="nextRead">➡ 下一个词</view>
    <view class="tip">跟读为纯视觉互动版：孩子点麦克风开口跟读，由家长根据表现手动打分，全程不录音、不采集任何音频，符合儿童隐私规范。</view>
  </view>

  <view class="finish-bar">
    <view class="btn btn-pink" bindtap="finishToday">🏆 完成今日英语练习</view>
  </view>
</view>
