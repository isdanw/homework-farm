<view class="page-wrap">

  <!-- ===== 卡通背景氛围层（云朵 / 星星 / 太阳 / 草丛） ===== -->
  <view class="scene" aria-hidden="true">
    <text class="sc sc-cloud" style="top:24rpx;left:18rpx">☁️</text>
    <text class="sc sc-cloud" style="top:60rpx;right:34rpx;font-size:42rpx">☁️</text>
    <text class="sc sc-star" style="top:150rpx;right:58rpx">⭐</text>
    <text class="sc sc-star" style="top:300rpx;left:22rpx;font-size:30rpx">✨</text>
    <text class="sc sc-sun" style="top:470rpx;right:22rpx">🌞</text>
    <text class="sc sc-star" style="top:560rpx;left:38rpx;font-size:26rpx">🌟</text>
    <view class="page-wave"></view>
  </view>

  <!-- ===== 状态 Hero：这是谁 + 今天 + 连续打卡 ===== -->
  <view class="hero">
    <view class="hero-mascot-wrap">
      <view class="hero-mascot">{{child.avatar}}</view>
      <text class="hero-buddy">🐻</text>
      <view class="hero-blush l"></view>
      <view class="hero-blush r"></view>
    </view>
    <view class="hero-body">
      <view class="hero-greet">嗨，{{child.nickname}}！<text wx:if="{{child.grade}}" class="hero-grade">{{child.grade}}</text></view>
      <view class="hero-sub">{{dateText}} {{weekText}}</view>
    </view>
    <view class="hero-streak">
      <text class="hs-fire">🔥</text>
      <view class="hs-text"><text class="hs-n">{{streak}}</text><text class="hs-u">天连续</text></view>
    </view>
  </view>

  <!-- ===== 精力条 / 节奏护盾（P1）：轻量资源条，非惩罚、不锁死 =====
       参数（上限 / 池大小）由儿童画像 learner 自动推导，不绑定年龄或年级 -->
  <view class="pace {{pace.level}}">
    <view class="pace-head">
      <text class="pace-ic">{{pace.emoji}}</text>
      <text class="pace-label">今日精力</text>
      <text class="pace-val">{{pace.energy}}/{{pace.pool}}</text>
      <text class="pace-tip" wx:if="{{pace.tip}}">{{pace.tip}}</text>
    </view>
    <view class="pace-track">
      <view class="pace-fill" style="width:{{pace.pct}}%"></view>
    </view>
    <view class="pace-sub">
      <text>本周已学 {{pace.weeklyUsed}} 分钟</text>
      <text>单节建议 {{pace.capMin}} 分钟内</text>
    </view>
  </view>

  <!-- ===== 学科情境横幅（P2）：轻量使命叙事，不喧宾夺主（置于精力条之下）=====
     身份按学科框架自动分配（内置 9 科 + 自定义兜底），不写死某一科 -->
  <view class="scen" wx:if="{{scenario}}" bindtap="toggleScenario">
    <view class="scen-head">
      <text class="scen-ic">{{scenario.emoji}}</text>
      <text class="scen-id">{{scenario.identity}}</text>
      <text class="scen-ch">第 {{scenario.chapter}} 段</text>
      <text class="scen-arrow">{{scenarioOpen ? '▾' : '▸'}}</text>
    </view>
    <view class="scen-track">
      <view class="scen-fill" style="width:{{scenario.nodePct}}%"></view>
    </view>
    <view class="scen-sub">
      <text>{{scenario.progressNoun}} {{scenario.progress}} 枚</text>
      <text>再 {{scenario.step - (scenario.progress % scenario.step)}} 次解锁下一段</text>
    </view>
    <view class="scen-frag" wx:if="{{scenarioOpen && scenario.latest}}">
      <text class="sf-t">{{scenario.latest.title}}</text>
      <text class="sf-x">{{scenario.latest.text}}</text>
    </view>
  </view>

  <!-- ===== 主行动：今日三科打卡（绝对 C 位） ===== -->
  <view class="act-card {{allDone ? 'all' : ''}}">
    <view class="sticker">⭐</view>
    <view class="act-head">
      <view class="act-title"><view class="dot" style="background:#F5B740"></view>今日打卡</view>
      <view class="act-count {{allDone ? 'done' : ''}}">{{doneNum}}/{{total}} 科</view>
    </view>

    <view class="sub-list">
      <view class="sub-row {{item.done ? 'done' : ''}}" wx:for="{{doors}}" wx:key="key"
            style="{{item.bg}}" data-key="{{item.key}}" bindtap="openCheckin">
        <view class="sr-main">
          <view class="sr-head">
            <text class="sr-name">{{item.name}}</text>
            <text class="sr-state">{{item.done ? '已完成' : '待打卡'}}</text>
          </view>
          <view wx:if="{{item.planTask}}" class="sr-task">
            <text class="sr-task-ic">📚</text>
            <text class="sr-task-tx">{{item.planTask}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 待办提醒（有错题待订正才显示，点击进错题本） -->
    <view wx:if="{{pendingMistakes}}" class="act-todo" bindtap="goMistakes">
      <view class="todo-dot"></view>
      <text class="todo-tx">有 {{pendingMistakes}} 道错题待订正</text>
      <text class="todo-go">去处理 ›</text>
    </view>

    <!-- 复习卡待回顾（G3：今日到期复习卡，点击进翻面自测） -->
    <view wx:if="{{dueCards}}" class="act-todo act-todo-card" bindtap="goCards">
      <view class="todo-dot todo-dot-card"></view>
      <text class="todo-tx">有 {{dueCards}} 张复习卡待回顾</text>
      <text class="todo-go">去自测 ›</text>
    </view>

    <!-- 进度条 + 反馈语 -->
    <view class="act-bar"><view class="act-fill" style="width:{{percent}}%"></view></view>
    <view wx:if="{{allDone}}" class="act-cheer">🎉 全部打卡完成，去农场领奖励吧！</view>
    <view wx:else class="act-tip">已完成 {{doneNum}} 项，再完成 <text class="hl">{{leftNum}}</text> 项就能去农场啦～</view>

    <!-- 今日课程（纯展示，不再跳转课表编辑） -->
    <view wx:if="{{todayCoursesText}}" class="act-courses">
      <text class="ac-ic">📅</text>
      <text class="ac-tx">今天：{{todayCoursesText}}</text>
    </view>

    <!-- 全勤撒花 -->
    <view class="confetti" wx:if="{{allDone}}">
      <view class="cf" style="left:18%;background:#FF8FAE;animation-delay:0s"></view>
      <view class="cf" style="left:42%;background:#FFD45E;animation-delay:.12s"></view>
      <view class="cf" style="left:64%;background:#5FBF6B;animation-delay:.24s"></view>
      <view class="cf" style="left:84%;background:#3FA9F5;animation-delay:.36s"></view>
    </view>
  </view>

  <!-- ===== 农场奖励联动：打卡 → 收获 → 去农场 ===== -->
  <view class="farm-card {{forecast.danger ? 'danger' : ''}}" bindtap="goFarm">
    <view class="sticker s-green">🌱</view>
    <view class="fc-left">
      <view class="fc-title">{{forecast.danger ? '⚠️ 农场有小狗熊' : '今天收获'}}</view>
      <view wx:if="{{forecast.danger}}" class="fc-desc">{{forecast.text}}</view>
      <view wx:else class="fc-desc">☀️ 阳光 {{farm.suns}} · 🌱 种子 {{seedsTotal}} · 🪙 金币 {{farm.coins}}</view>
      <view class="fc-meta">{{forecast.danger ? ('小狗熊 ' + farm.bears + ' 只 · 杀虫剂 ' + farm.pesticide + ' 瓶') : '农场一切安好，去种点东西吧～'}}</view>
    </view>
    <view class="fc-right">
      <view class="mini-farm">
        <view class="mf-sun"></view>
        <view class="mf-plant"><view class="mf-stem"></view><view class="mf-leaf l"></view><view class="mf-leaf r"></view></view>
        <view class="mf-soil"></view>
      </view>
      <view class="go">进入农场 ›</view>
    </view>
  </view>

  <!-- ===== 快捷入口：成长计划 ===== -->
  <view class="entry-card" bindtap="goPlan">
    <view class="sticker s-green">🗓</view>
    <view class="ec-icon">🎯</view>
    <view class="ec-body">
      <view class="ec-title">成长计划</view>
      <view class="ec-sub">{{planEntryText}}</view>
    </view>
    <view class="ec-go">›</view>
  </view>

</view>
