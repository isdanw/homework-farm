<view class="page-wrap mall-page">

  <!-- 头像 + 金币 -->
  <view class="me-card">
    <view class="avatar-box {{frameClass}}">
      <view class="avatar">
        <view class="a-hair"></view>
        <view class="a-face"><view class="a-eye l"></view><view class="a-eye r"></view><view class="a-cheek l"></view><view class="a-cheek r"></view><view class="a-smile"></view></view>
      </view>
    </view>
    <view class="me-info">
      <view class="me-name">{{nickname}}</view>
      <view class="me-sub">连续打卡 {{streak}} 天</view>
    </view>
    <view class="me-coin"><view class="ic-coin"></view>{{coins}}</view>
  </view>

  <!-- 分类 -->
  <view class="mtabs">
    <view class="mt {{tab==='cert'?'on':''}}" data-t="cert" bindtap="switchTab">虚拟奖状</view>
    <view class="mt {{tab==='frame'?'on':''}}" data-t="frame" bindtap="switchTab">头像框</view>
    <view class="mt {{tab==='skin'?'on':''}}" data-t="skin" bindtap="switchTab">装扮皮肤</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card m-card">
    <view class="m-row">
      <!-- 预览图（纯 CSS） -->
      <view class="m-prev">
        <view wx:if="{{item.kind==='cert'}}" class="pv-cert" style="border-color:{{item.color}}">
          <view class="pc-ribbon" style="background:{{item.color}}"></view>
          <view class="pc-line"></view><view class="pc-line short"></view>
        </view>
        <view wx:elif="{{item.kind==='frame'}}" class="pv-frame" style="border-color:{{item.color}}">
          <view class="pf-dot" style="background:{{item.color}}"></view>
        </view>
        <view wx:else class="pv-skin" style="background:linear-gradient(180deg,{{item.color}},#FFF9F0)"></view>
      </view>

      <view class="m-main">
        <view class="m-name">{{item.name}}</view>
        <view class="m-desc">{{item.desc}}</view>
        <view class="m-price"><view class="ic-coin"></view>{{item.price}} 金币</view>
      </view>

      <view class="m-btns">
        <view wx:if="{{!item.owned}}" class="btn btn-sm {{item.canBuy ? 'btn-yellow' : 'btn-gray'}}" data-id="{{item.id}}" bindtap="buy">兑换</view>
        <block wx:else>
          <view wx:if="{{item.kind==='cert'}}" class="btn btn-sm btn-line" data-id="{{item.id}}" bindtap="tapCert">看奖状</view>
          <view wx:else class="btn btn-sm {{item.equipped ? 'btn-gray' : 'btn-green'}}" data-id="{{item.id}}" bindtap="equip">{{item.equipped ? '已装备' : '装备'}}</view>
        </block>
      </view>
    </view>
  </view>

  <view class="card tip-card">
    <view class="tip-line">金币来自农场收获，多完成任务 → 多种植物 → 多赚金币</view>
    <view class="tip-line danger">漏做任务会被偷走一半金币，攒大奖励前一定要打满卡哦</view>
  </view>
</view>

<!-- 奖状预览 -->
<view wx:if="{{showCert}}" class="mask" bindtap="closeCert">
  <view class="cert-paper" catchtap="" style="border-color:{{cert.color}}">
    <view class="cp-top" style="background:{{cert.color}}"></view>
    <view class="cp-title">奖　状</view>
    <view class="cp-name">{{cert.nickname}} 小朋友</view>
    <view class="cp-body">
      你在暑假习惯打卡中表现优秀，连续打卡 {{cert.streak}} 天，
      在自己的农场收获了 {{cert.harvest}} 份果实，
      是一位坚持又认真的小农场主，特发此状，以资鼓励！
    </view>
    <view class="cp-foot">
      <view class="cp-award">{{cert.name}}</view>
      <view class="cp-date">{{cert.date}}</view>
    </view>
    <view class="cp-seal">优秀</view>
    <view class="btn btn-sm btn-gray cp-close" bindtap="closeCert">收起</view>
  </view>
</view>
