/* 错题本样式 */
.filters { margin-bottom: 20rpx; }
.f-row { display: flex; gap: 14rpx; margin-bottom: 14rpx; flex-wrap: wrap; }
.f {
  flex: 1; min-height: 76rpx; line-height: 76rpx; text-align: center;
  background: #fff; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; color: #7A8792;
  box-shadow: 0 4rpx 14rpx rgba(150,180,210,.12);
}
.f.on { background: #FFC9DC; color: #fff; }
.f.small { flex: 0 0 auto; padding: 0 30rpx; }

.err-card { border-left: 10rpx solid #FFC9DC; }
.err-card.ok { border-left-color: #A8E6A1; background: #FAFFFA; }
.e-top { display: flex; gap: 18rpx; }
.e-main { flex: 1; min-width: 0; }
.e-title { font-size: 32rpx; font-weight: 700; line-height: 1.5; }
.e-reason { font-size: 26rpx; color: #8A8A8A; margin-top: 6rpx; }
.e-date { font-size: 22rpx; color: #B5BFC9; margin-top: 6rpx; }
.e-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }

.pick-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.pick {
  flex: 1; min-height: 80rpx; line-height: 80rpx; border-radius: 20rpx;
  background: #F2F6FA; font-size: 30rpx; font-weight: 700; color: #6A6A6A; text-align: center;
}
.pick.on { color: #fff; }
