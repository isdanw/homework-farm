/* ============ 登录门 ============ */
.login {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 48rpx calc(80rpx + env(safe-area-inset-bottom)) 48rpx;
  background:
    radial-gradient(1200rpx 600rpx at 50% -10%, #DFF3FF 0%, rgba(223,243,255,0) 60%),
    var(--c-cream);
  display: flex;
  flex-direction: column;
}

/* 品牌区 */
.brand { text-align: center; margin-bottom: 80rpx; }
.logo {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #FFE6C7, #FFC9DC);
  display: flex; align-items: center; justify-content: center;
  font-size: 92rpx;
  box-shadow: 0 12rpx 30rpx rgba(255, 180, 200, .4);
}
.title { font-size: 52rpx; font-weight: 800; letter-spacing: 2rpx; }
.sub { font-size: 28rpx; color: var(--c-sub); margin-top: 12rpx; }

/* 微信登录按钮 */
.tip {
  text-align: center; font-size: 30rpx; color: var(--c-text);
  margin-bottom: 40rpx; font-weight: 600;
}
.wx-btn {
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; max-width: 100%;
  width: 100%; min-height: 96rpx;
  background: #07C160; color: #fff;
  font-size: 34rpx; font-weight: 700; border-radius: 48rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .08);
}
.wx-btn:active { transform: translateY(3rpx); box-shadow: none; }
.wx-ic { font-size: 40rpx; margin-right: 12rpx; }
.privacy {
  margin-top: 36rpx; font-size: 24rpx; color: var(--c-sub);
  line-height: 1.7; text-align: center;
}

/* 资料表单 */
.card {
  background: #fff; border-radius: var(--radius);
  padding: 32rpx 28rpx; margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(150, 180, 210, .14);
}
.sec-t {
  font-size: 30rpx; font-weight: 700; color: var(--c-text);
  margin: 28rpx 0 18rpx;
}
.sec-t:first-child { margin-top: 0; }
.nick {
  width: 100%; box-sizing: border-box;
  background: #F6F9FC; border-radius: 20rpx;
  padding: 22rpx 24rpx; font-size: 32rpx;
}
.ph { color: #B5BFC9; }

.emoji-grid {
  display: grid; grid-template-columns: repeat(6, 1fr); gap: 16rpx;
}
.emoji {
  height: 92rpx; border-radius: 22rpx;
  background: #F6F9FC;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; border: 4rpx solid transparent;
}
.emoji.on { border-color: var(--c-blue-deep); background: #EAF7FF; }

.grade-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.grade {
  padding: 16rpx 24rpx; border-radius: 24rpx;
  background: #F6F9FC; color: var(--c-sub);
  font-size: 28rpx; font-weight: 600; border: 4rpx solid transparent;
}
.grade.on { border-color: var(--c-green-deep); color: var(--c-green-deep); background: #EFFBEF; font-weight: 800; }

.enter-btn {
  box-sizing: border-box; max-width: 100%;
  width: 100%; min-height: 96rpx;
  background: var(--c-green-deep); color: #fff;
  font-size: 34rpx; font-weight: 700; border-radius: 48rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .08);
}
.enter-btn:active { transform: translateY(3rpx); box-shadow: none; }
