/* ===== 单元总结页 ===== */

.us-meta { font-size: 25rpx; margin-bottom: 8rpx; }

.us-loading {
  text-align: center; padding: 80rpx 0 60rpx;
  color: var(--c-sub); font-size: 27rpx;
}
.us-loading-emoji { font-size: 72rpx; margin-bottom: 20rpx; animation: us-bounce 1.2s ease-in-out infinite; }
@keyframes us-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.us-fail {
  background: #FFF3E0; border: 2rpx solid #FFD9A8; color: #B3621B;
  border-radius: 18rpx; padding: 16rpx 22rpx;
  font-size: 24rpx; margin-bottom: 16rpx;
}

/* 文字总结 */
.us-summary {
  font-size: 28rpx; line-height: 1.8; color: var(--c-text);
  background: #F6F9FC; border-radius: 18rpx; padding: 20rpx 24rpx;
  margin: 18rpx 0 14rpx;
}
.us-advice { margin-bottom: 8rpx; }
.us-advice-item {
  font-size: 26rpx; color: #5A5A5A; line-height: 1.7;
  padding: 8rpx 0;
}

/* 仿黑板知识树画布（750:1280 比例，长图便于保存分享） */
.us-board {
  width: 100%; height: 1180rpx;
  margin-top: 18rpx; border-radius: 16rpx;
}
.us-tip { font-size: 22rpx; text-align: center; margin-top: 12rpx; }

/* 操作 */
.us-acts { display: flex; gap: 20rpx; margin-top: 20rpx; }
.us-btn { flex: 1; }
