.page { padding: 24rpx 28rpx 60rpx; min-height: 100vh; background: #FFF9F0; }

.topbar { display: flex; flex-direction: column; margin-bottom: 20rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #2B3A4A; }
.sub { font-size: 24rpx; color: #9AA5B1; margin-top: 4rpx; }

.stat { display: flex; gap: 20rpx; margin: 16rpx 0 24rpx; }
.stat-item {
  flex: 1; background: #fff; border-radius: 20rpx; padding: 24rpx 0;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(63,169,245,0.08);
}
.stat-item .num { font-size: 48rpx; font-weight: 700; color: #3FA9F5; }
.stat-item .lab { font-size: 24rpx; color: #9AA5B1; margin-top: 6rpx; }

.actions { margin-bottom: 20rpx; }
.btn-primary {
  background: #3FA9F5; color: #fff; border-radius: 999rpx; font-size: 30rpx;
  padding: 20rpx 0; border: none;
}
.btn-primary[disabled] { background: #CFE6F7; color: #fff; }

.section-title { font-size: 28rpx; color: #2B3A4A; font-weight: 600; margin: 16rpx 4rpx; }

.empty {
  background: #fff; border-radius: 20rpx; padding: 40rpx 28rpx; text-align: center;
  color: #9AA5B1; font-size: 26rpx; line-height: 1.6;
}

.card-row {
  background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(63,169,245,0.06);
}
.card-front { font-size: 30rpx; color: #2B3A4A; line-height: 1.5; }
.card-meta { font-size: 22rpx; color: #9AA5B1; margin-top: 10rpx; }

.done-tip { text-align: center; color: #F2994A; font-size: 26rpx; margin-top: 20rpx; }

.study-card {
  background: #fff; border-radius: 24rpx; padding: 48rpx 36rpx; margin: 20rpx 0;
  min-height: 320rpx; display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(63,169,245,0.12);
}
.study-sub { font-size: 24rpx; color: #9AA5B1; margin-bottom: 24rpx; }
.study-face { font-size: 38rpx; color: #2B3A4A; text-align: center; line-height: 1.6; }
.study-hint { font-size: 24rpx; color: #3FA9F5; margin-top: 32rpx; }

.rate-row { display: flex; gap: 20rpx; margin: 8rpx 0 16rpx; }
.btn-good { flex: 1; background: #E8F8EF; color: #27AE60; border-radius: 999rpx; font-size: 30rpx; border: none; padding: 20rpx 0; }
.btn-again { flex: 1; background: #FDEEEE; color: #EB5757; border-radius: 999rpx; font-size: 30rpx; border: none; padding: 20rpx 0; }

.btn-ghost { background: transparent; color: #9AA5B1; font-size: 26rpx; border: none; margin-top: 8rpx; }
