page {
  background: #FFF9F0;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #3A3A3A;
}

.page { padding: 24rpx 24rpx 60rpx; }

.topbar { padding: 12rpx 8rpx 20rpx; }
.topbar .title { display: block; font-size: 40rpx; font-weight: 800; color: #3A3A3A; }
.topbar .sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #9A8F7D; }

.toolbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.filter-pick { flex: 1; }
.filter-btn {
  background: #fff; border: 2rpx solid #F0E4CE; border-radius: 16rpx;
  padding: 14rpx 20rpx; font-size: 26rpx; color: #6B5F4E;
}
.new-btn {
  background: #FFB84D; color: #fff; font-size: 26rpx; font-weight: 700;
  border-radius: 16rpx; padding: 14rpx 24rpx;
}
.search-btn {
  background: #fff; color: #8A7A5C; font-size: 26rpx; font-weight: 600;
  border: 2rpx solid #F0E4CE; border-radius: 16rpx; padding: 14rpx 20rpx;
}
.op-hover { opacity: 0.75; }

.loading { text-align: center; color: #B0A68F; font-size: 24rpx; padding: 30rpx 0; }

.section-title {
  font-size: 28rpx; font-weight: 800; color: #6B5F4E;
  margin: 24rpx 8rpx 14rpx;
}

.empty { text-align: center; color: #B0A68F; font-size: 24rpx; padding: 30rpx 0; }

/* ---- 教材卡片 ---- */
.tb-card {
  background: #fff; border-radius: 20rpx; padding: 22rpx;
  margin-bottom: 16rpx; box-shadow: 0 4rpx 12rpx rgba(190, 160, 100, 0.08);
}
.tb-title { font-size: 30rpx; font-weight: 700; color: #3A3A3A; line-height: 1.4; }
.tb-meta { margin-top: 10rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.tb-dim { font-size: 22rpx; color: #9A8F7D; }
.tb-url {
  margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tb-snippet {
  margin-top: 6rpx; line-height: 1.5;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.tb-actions { margin-top: 14rpx; display: flex; gap: 12rpx; justify-content: flex-end; }
.tb-units {
  margin-top: 14rpx; padding-top: 14rpx; border-top: 2rpx solid #F7EFDF;
}
.tb-unit { padding: 8rpx 0; }
.tb-unit-name { font-size: 24rpx; color: #6B5F4E; font-weight: 600; }
.tb-unit-sub { display: block; font-size: 22rpx; color: #B0A68F; margin-top: 4rpx; }

/* ---- 标签 ---- */
.tag { font-size: 20rpx; border-radius: 8rpx; padding: 4rpx 12rpx; }
.t-g { background: #E8F7EC; color: #3E9B5F; }
.t-b { background: #E8F3FD; color: #3FA9F5; }
.t-a { background: #FFF3E0; color: #E8930C; }
.t-n { background: #F5F0E8; color: #9A8F7D; }

/* ---- 小按钮 ---- */
.mini-btn {
  font-size: 22rpx; color: #6B5F4E; background: #F7EFDF;
  border-radius: 10rpx; padding: 8rpx 18rpx;
}
.mini-btn.primary { background: #FFB84D; color: #fff; font-weight: 600; }
.mini-btn.danger { background: #FDE8E8; color: #D64545; }

.foot-note {
  margin-top: 30rpx; padding: 0 8rpx;
  font-size: 20rpx; color: #C4B8A2; line-height: 1.6;
}

/* ---- 弹层 ---- */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(60, 45, 20, 0.45); z-index: 999;
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet {
  width: 100%; background: #FFFDF8; border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx 48rpx; max-height: 82vh;
  display: flex; flex-direction: column;
}
.sheet-tall { max-height: 88vh; }
.sheet-title { font-size: 34rpx; font-weight: 800; color: #3A3A3A; }
.sheet-desc { margin-top: 10rpx; font-size: 24rpx; color: #9A8F7D; line-height: 1.6; }
.sheet-btns { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }

.big-btn {
  background: #F7EFDF; color: #6B5F4E; font-size: 28rpx; font-weight: 600;
  border-radius: 16rpx; padding: 20rpx; text-align: center;
}
.big-btn.primary { background: #FFB84D; color: #fff; }
.big-btn.ghost { background: transparent; color: #B0A68F; font-weight: 400; }

/* ---- 表单 ---- */
.form-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 18rpx;
}
.form-lab { width: 110rpx; font-size: 26rpx; color: #6B5F4E; font-weight: 600; flex-shrink: 0; }
.form-inp {
  flex: 1; background: #fff; border: 2rpx solid #F0E4CE; border-radius: 12rpx;
  padding: 14rpx 18rpx; font-size: 26rpx; color: #3A3A3A;
}
.form-pick {
  flex: 1; background: #fff; border: 2rpx solid #F0E4CE; border-radius: 12rpx;
  padding: 14rpx 18rpx; font-size: 26rpx; color: #3A3A3A;
}
.ph { color: #C4B8A2; }

.paste-area {
  margin-top: 18rpx; width: 100%; height: 300rpx;
  background: #fff; border: 2rpx solid #F0E4CE; border-radius: 12rpx;
  padding: 16rpx; font-size: 26rpx; color: #3A3A3A; line-height: 1.6;
}

/* flex 子项默认 min-height:auto 不肯缩到内容以下 → scroll-view 被内容撑爆、
   底部按钮被顶出弹窗。min-height:0 允许收缩，scroll-y 才生效（2026-10-26 实修） */
.edit-scroll { flex: 1; min-height: 0; margin-top: 8rpx; }

/* ---- 官方库比对卡 ---- */
.cmp-card {
  margin-top: 16rpx; background: #FFF6E8; border: 2rpx solid #FFE2B8;
  border-radius: 16rpx; padding: 20rpx 22rpx;
}
.cmp-summary { display: flex; flex-direction: column; gap: 6rpx; }
.cmp-t { font-size: 26rpx; font-weight: 700; color: #6B5F4E; }
.cmp-stats { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.cmp-num { font-size: 22rpx; font-weight: 600; }
.cmp-num.ok { color: #4CAF7D; }
.cmp-num.add { color: #E8833A; }
.cmp-num.miss { color: #B0632F; }
.cmp-arrow { margin-left: auto; font-size: 22rpx; color: #B0A68F; }
.cmp-rows { margin-top: 14rpx; max-height: 420rpx; overflow-y: auto; }
.cmp-row {
  display: flex; align-items: flex-start; gap: 12rpx;
  padding: 8rpx 0; border-top: 2rpx dashed #F0E4CE;
}
.cmp-ico { width: 34rpx; font-size: 24rpx; font-weight: 800; flex-shrink: 0; text-align: center; }
.cmp-ico.same { color: #4CAF7D; }
.cmp-ico.section_diff { color: #E8A33A; }
.cmp-ico.draft_only { color: #E8833A; }
.cmp-ico.seed_only { color: #B0632F; }
.cmp-name { font-size: 24rpx; color: #3A3A3A; font-weight: 600; flex-shrink: 0; max-width: 240rpx; }
.cmp-note { font-size: 22rpx; color: #9A8F7D; line-height: 1.5; }
.cmp-btns { margin-top: 16rpx; display: flex; gap: 14rpx; }
.cmp-btns .mini-btn { flex: 1; text-align: center; }

.units-head {
  margin-top: 24rpx; display: flex; align-items: center; justify-content: space-between;
  font-size: 28rpx; font-weight: 800; color: #6B5F4E;
}
.unit-edit {
  background: #fff; border: 2rpx solid #F0E4CE; border-radius: 14rpx;
  padding: 16rpx; margin-top: 14rpx;
}
.unit-edit-head { display: flex; align-items: center; gap: 10rpx; }
.unit-no { font-size: 26rpx; color: #B0A68F; font-weight: 700; }
.unit-area {
  margin-top: 12rpx; width: 100%; height: 120rpx;
  background: #FFFDF8; border: 2rpx solid #F0E4CE; border-radius: 10rpx;
  padding: 12rpx; font-size: 24rpx; color: #3A3A3A; line-height: 1.5;
}
