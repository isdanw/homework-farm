.page { padding: 28rpx 28rpx 60rpx; }
.state { text-align: center; color: #6b7280; margin-top: 80rpx; font-size: 28rpx; }
.err { color: #dc2626; }
.exam-head { margin-bottom: 24rpx; }
.exam-name { font-size: 34rpx; font-weight: 700; color: #1f2937; display: block; }
.exam-meta { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; display: block; }
.q { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.q-title { font-size: 30rpx; color: #374151; line-height: 1.6; }
.q-no { color: #2563eb; font-weight: 700; margin-right: 8rpx; }
.q-kp { color: #f59e0b; font-size: 24rpx; margin-left: 8rpx; }
.q-pts { color: #10b981; font-size: 24rpx; margin-left: 8rpx; float: right; }
.q-fig { width: 100%; margin: 16rpx 0 6rpx; display: block; }
.opts { margin-top: 16rpx; }
.opt { padding: 18rpx 20rpx; background: #f8fafc; border-radius: 12rpx; margin-bottom: 12rpx; font-size: 28rpx; color: #374151; border: 2rpx solid transparent; }
.opt.on { background: #eff6ff; border-color: #2563eb; color: #1d4ed8; }
.text-in { margin-top: 14rpx; background: #f8fafc; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; }
.text-in.mini { margin-top: 12rpx; }
.text-ar { margin-top: 14rpx; width: 100%; min-height: 160rpx; background: #f8fafc; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; box-sizing: border-box; }
.draw-box { margin-top: 14rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.draw-btn { background: #eff6ff; color: #2563eb; border-radius: 10rpx; font-size: 26rpx; margin: 0; }
.draw-flag { color: #10b981; font-size: 26rpx; }
.submit-btn { margin-top: 36rpx; background: #2563eb; color: #fff; border-radius: 16rpx; font-size: 32rpx; }

/* 书写弹层 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
.sheet { width: 88%; background: #fff; border-radius: 20rpx; padding: 24rpx; }
.sheet-head { display: flex; justify-content: space-between; font-size: 30rpx; font-weight: 600; color: #1f2937; margin-bottom: 16rpx; }
.sheet-close { color: #9ca3af; }
.draw-canvas { width: 100%; height: 560rpx; background: #fff; border: 2rpx solid #e5e7eb; border-radius: 12rpx; }
.sheet-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.sheet-tip { font-size: 22rpx; color: #9ca3af; margin-top: 12rpx; line-height: 1.5; }
