page { background: var(--c-cream); }

.tutor-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-top: 16rpx;
}

/* ---------------- 学科切换（九科横向滚动） ---------------- */
.subject-bar {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
}
.sub-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  background: #fff;
  color: var(--c-sub);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(150, 180, 210, 0.16);
  border: 3rpx solid transparent;
  flex-shrink: 0;
}
.sub-pill.on {
  border-color: var(--c-blue);
  color: var(--c-blue-deep);
  background: #F2FAFF;
  font-weight: 800;
}
.sp-emoji { font-size: 32rpx; }

/* ---------------- 成长计划任务横幅 ---------------- */
.task-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 4rpx 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #EAF5FF;
  border-radius: 20rpx;
}
.tb-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  background: var(--c-blue-deep);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-weight: 600;
}
.tb-body { flex: 1; min-width: 0; }
.tb-name { font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.tb-goal { font-size: 24rpx; color: var(--c-sub); margin-top: 2rpx; }

/* ---------------- 归档提示 ---------------- */
.archive-tip {
  text-align: center;
  color: var(--c-sub);
  font-size: 24rpx;
  padding-bottom: 8rpx;
}

/* ---------------- 消息区 ---------------- */
.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}

.welcome { text-align: center; padding: 60rpx 20rpx; }
.welcome-emoji { font-size: 96rpx; }
.welcome-title { font-size: 38rpx; font-weight: 800; margin: 20rpx 0 12rpx; }
.welcome-sub { font-size: 26rpx; color: var(--c-sub); line-height: 1.7; }

.msg-row { display: flex; margin-bottom: 24rpx; align-items: flex-start; }
.msg-row.from-user { flex-direction: row-reverse; }

.msg-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; flex-shrink: 0;
  background: #fff; box-shadow: 0 4rpx 12rpx rgba(150, 180, 210, 0.16);
}
.msg-row.from-user .msg-avatar { margin-left: 16rpx; }
.msg-row.from-ai .msg-avatar { margin-right: 16rpx; }

.msg-bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
  box-shadow: 0 4rpx 12rpx rgba(150, 180, 210, 0.12);
}
.msg-row.from-ai .msg-bubble {
  background: #fff;
  color: var(--c-text);
  border-top-left-radius: 6rpx;
}
.msg-row.from-user .msg-bubble {
  background: var(--c-blue-deep);
  color: #fff;
  border-top-right-radius: 6rpx;
}
.msg-bubble.typing { color: var(--c-sub); }

/* ---------------- 底部输入区 ---------------- */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #EEF2F7;
}
.input-box {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #F6F9FC;
  border-radius: 38rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.send-btn {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--c-blue-deep);
  color: #fff;
  border-radius: 38rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 24rpx;
}
.send-btn.disabled { opacity: 0.5; }

.end-bar {
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.end-btn {
  height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 36rpx;
  color: var(--c-blue-deep);
  border: 3rpx solid var(--c-blue);
  font-size: 28rpx;
  font-weight: 700;
}
