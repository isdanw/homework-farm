<view class="tutor-page">

  <!-- ===== 锁定态（导学未启用 · 2026-09-22） ===== -->
  <view wx:if="{{locked}}" style="position:fixed;left:0;top:0;right:0;bottom:0;z-index:50;background:var(--c-cream,#FFF9F0);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 64rpx;text-align:center;">
    <view style="font-size:120rpx;line-height:1;">🔒</view>
    <view style="margin-top:24rpx;font-size:38rpx;font-weight:800;color:#3A3A3A;">导学功能暂未启用</view>
    <view style="margin-top:16rpx;font-size:28rpx;color:#888;line-height:1.6;">
      <block wx:if="{{lockReason === 'no-child'}}">请先在「我的」添加孩子，才能使用导学功能。</block>
      <block wx:elif="{{lockReason === 'no-bind'}}">导学功能需绑定微信后使用，数据将与该账号同步、可跨设备查看。本地模式仅保留打卡与农场。</block>
      <block wx:else>请先为孩子建立「成长计划」，才能使用导学功能。</block>
    </view>
    <view style="margin-top:48rpx;display:flex;flex-direction:column;gap:20rpx;width:100%;">
      <view wx:if="{{lockReason === 'no-child'}}" style="background:#5FBF6B;color:#fff;font-size:30rpx;font-weight:700;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="goMine">去添加孩子</view>
      <view wx:elif="{{lockReason === 'no-bind'}}" style="background:#5FBF6B;color:#fff;font-size:30rpx;font-weight:700;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="goMine">去绑定微信</view>
      <view wx:else style="background:#5FBF6B;color:#fff;font-size:30rpx;font-weight:700;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="goPlanFromTutor">去建立计划</view>
      <view style="background:#fff;color:#666;border:3rpx solid #E2E2E2;font-size:30rpx;font-weight:600;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="lockBack">返回</view>
    </view>
  </view>

  <!-- 学科切换（九科横向滚动） -->
  <scroll-view class="subject-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view wx:for="{{subjects}}" wx:key="key"
          class="sub-pill {{item.key === subject ? 'on' : ''}}"
          data-key="{{item.key}}" bindtap="pickSubject">
      <text class="sp-emoji">{{item.emoji}}</text>
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 成长计划任务横幅 -->
  <view class="task-banner" wx:if="{{taskContext}}">
    <view class="tb-tag">正在导学</view>
    <view class="tb-body">
      <view class="tb-name">{{taskContext.stage}} · {{taskContext.task}}</view>
      <view class="tb-goal" wx:if="{{taskContext.goal}}">目标：{{taskContext.goal}}</view>
    </view>
  </view>

  <!-- 错题订正横幅 -->
  <view class="task-banner" wx:elif="{{mistakeContext}}">
    <view class="tb-tag">订正</view>
    <view class="tb-body">
      <view class="tb-name">{{mistakeContext.topic}}</view>
      <view class="tb-goal" wx:if="{{mistakeContext.errorType}}">错因：{{mistakeContext.errorTypeLabel}}</view>
    </view>
  </view>

  <!-- 归档提示 -->
  <view class="archive-tip" wx:if="{{archivedCount > 0}}">已归档 {{archivedCount}} 次导学记录</view>

  <!-- 消息区 -->
  <scroll-view class="msg-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:if="{{!messages.length && !input}}" class="welcome">
      <view class="welcome-emoji">{{subjectEmoji}}</view>
      <view class="welcome-title">开始{{subjectName}}导学吧</view>
      <view class="welcome-sub">把不会的题、或者你的想法发给我，我会一步步引导你想出来，不会直接给答案哦～</view>
    </view>

    <view wx:for="{{messages}}" wx:key="index"
          class="msg-row {{item.role === 'user' ? 'from-user' : 'from-ai'}}">
      <view class="msg-avatar">{{item.role === 'user' ? '🐯' : '🤖'}}</view>
      <view class="msg-bubble">{{item.content}}</view>
    </view>

    <view wx:if="{{sending}}" class="msg-row from-ai">
      <view class="msg-avatar">🤖</view>
      <view class="msg-bubble typing">老师正在想…</view>
    </view>

    <view id="msg-bottom" style="height:4rpx"></view>
  </scroll-view>

  <!-- 语音输入引导：不录音，用系统键盘麦克风（文字直接进输入框） -->
  <view class="voice-hint">🎤 想用语音？点输入框后用键盘上的麦克风说就行 · 本应用不录音</view>

  <!-- 底部输入区 -->
  <view class="input-bar">
    <input class="input-box" value="{{input}}" placeholder="把题目或你的想法发给我…"
           confirm-type="send" bindinput="onInput" bindconfirm="send" disabled="{{sending}}" />
    <view class="send-btn {{sending ? 'disabled' : ''}}" bindtap="send">发送</view>
  </view>

  <!-- 结束本次导学并归档 -->
  <view class="end-bar">
    <view class="end-btn" bindtap="endSession">✓ 结束本次导学并归档</view>
  </view>

</view>
