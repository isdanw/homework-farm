/**
 * order.wxss —— 学习单页（沿用全局马卡龙规范：--c-blue-deep / --c-cream / --radius）
 * 视觉约束：一屏内层次分明——页签 → 分步标题 → 卡片 → 主行动按钮。
 * 不使用任何红色系表达「未完成」（避免与农场奖励语义冲突），提示用黄、完成用绿。
 */

page { background: var(--c-cream); }

.or-page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------------- 页签 ---------------- */
.or-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(150, 180, 210, 0.12);
}
.or-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
  color: var(--c-sub);
  border-radius: 999rpx;
}
.or-tab--on {
  background: var(--c-blue-deep);
  color: #FFFFFF;
  font-weight: 700;
}

/* ---------------- 通用状态 ---------------- */
.or-state { text-align: center; padding: 100rpx 40rpx; }
.or-state-emoji { font-size: 88rpx; }
.or-state-title { font-size: 32rpx; font-weight: 700; margin-top: 18rpx; }
.or-state-sub { font-size: 26rpx; color: var(--c-sub); margin-top: 14rpx; line-height: 1.75; }
.or-state .or-btn { margin-top: 32rpx; }

.or-hint {
  background: #F2FAFF;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 25rpx;
  color: #4E7A9B;
  line-height: 1.7;
  margin-bottom: 20rpx;
}
.or-note {
  font-size: 24rpx;
  color: var(--c-sub);
  line-height: 1.7;
  margin: 16rpx 4rpx 20rpx;
}
.or-foot {
  font-size: 23rpx;
  color: var(--c-sub);
  line-height: 1.7;
  margin: 24rpx 4rpx 10rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #E8EDF2;
}

/* ---------------- 分步标题 ---------------- */
.or-sec-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--c-text);
  margin: 24rpx 4rpx 14rpx;
}

/* ---------------- 步骤条 ---------------- */
.or-steps { display: flex; gap: 10rpx; margin-bottom: 20rpx; }
.or-step {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  padding: 10rpx 0;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--c-sub);
  border: 2rpx solid #EDF2F7;
}
.or-step--on { background: #EAF5FF; color: var(--c-blue-deep); border-color: var(--c-blue); font-weight: 700; }

/* ---------------- 计划卡（可点选） ---------------- */
.or-cards { display: flex; flex-direction: column; gap: 14rpx; }
.or-card {
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 22rpx 24rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 14rpx rgba(150, 180, 210, 0.10);
}
.or-card--on { border-color: var(--c-blue-deep); background: #F7FCFF; }
.or-card-top { display: flex; align-items: center; gap: 10rpx; }
.or-card-emoji { font-size: 32rpx; }
.or-card-name { font-size: 30rpx; font-weight: 700; }
.or-card-sub { font-size: 26rpx; color: var(--c-text); margin-top: 10rpx; line-height: 1.55; word-break: break-all; }
.or-card-meta { font-size: 23rpx; color: var(--c-sub); margin-top: 8rpx; }

.or-chip {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #F0F2F5;
  color: var(--c-sub);
}
.or-chip--warn { background: #FFF6DD; color: #B98514; }

/* ---------------- 行（任务 / 出单 / 详解入口） ---------------- */
.or-list { display: flex; flex-direction: column; gap: 12rpx; }
.or-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 14rpx rgba(150, 180, 210, 0.08);
}
.or-row--on { border-color: var(--c-green-deep); background: #F6FFF5; }
.or-row--tap { margin-bottom: 12rpx; }
.or-row-main { flex: 1; min-width: 0; }
.or-row-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.or-row-sub { font-size: 23rpx; color: var(--c-sub); margin-top: 8rpx; line-height: 1.6; word-break: break-all; }
.or-radio { font-size: 30rpx; color: var(--c-green-deep); }
.or-arrow { font-size: 36rpx; color: #C8D2DC; }

.or-st { font-weight: 700; }
.or-st--issued { color: #B98514; }
.or-st--submitted { color: var(--c-green-deep); }
.or-st--closed { color: var(--c-blue-deep); }
.or-st--cancelled, .or-st--voided { color: #A8B0B8; }

/* ---------------- 药丸选择 ---------------- */
.or-pills { display: flex; flex-wrap: wrap; gap: 14rpx; }
.or-pills--tight { gap: 10rpx; margin-top: 14rpx; }
.or-pill {
  font-size: 26rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--c-text);
  border: 3rpx solid #EDF2F7;
}
.or-pill--on { background: #EAF5FF; border-color: var(--c-blue-deep); color: var(--c-blue-deep); font-weight: 700; }
.or-pills--tight .or-pill { font-size: 24rpx; padding: 10rpx 20rpx; }

/* ---------------- 表单 ---------------- */
.or-ta {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 20rpx;
}
.or-ta--sm { min-height: 120rpx; }
.or-field { margin-bottom: 22rpx; }
.or-field-label { font-size: 25rpx; font-weight: 600; color: var(--c-text); margin: 0 4rpx 10rpx; }
.or-input {
  width: 100%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
}
.or-triple { display: flex; gap: 14rpx; }
.or-input--num { flex: 1; text-align: center; }

/* ---------------- 按钮 ---------------- */
.or-btn {
  text-align: center;
  font-size: 29rpx;
  font-weight: 700;
  padding: 26rpx 0;
  border-radius: 999rpx;
  margin-top: 26rpx;
}
.or-btn--primary { background: var(--c-blue-deep); color: #FFFFFF; box-shadow: 0 8rpx 20rpx rgba(63, 169, 245, 0.28); }
.or-btn--ghost { background: #FFFFFF; color: var(--c-blue-deep); border: 3rpx solid var(--c-blue); }
.or-btn--danger { background: #FFF2F2; color: #D9534F; border: 3rpx solid #FFD9D9; }
.or-btn--disabled { opacity: .55; }

/* ---------------- 概览数字 ---------------- */
.or-counts { display: flex; gap: 12rpx; margin-bottom: 10rpx; }
.or-count {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(150, 180, 210, 0.08);
}
.or-count-n { font-size: 40rpx; font-weight: 800; color: var(--c-blue-deep); }
.or-count-l { font-size: 22rpx; color: var(--c-sub); margin-top: 6rpx; }

/* ---------------- 计划聚合卡 ---------------- */
.or-aggcard {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(150, 180, 210, 0.08);
}
.or-agg-head { font-size: 28rpx; font-weight: 700; }
.or-agg-sub { font-size: 21rpx; color: #A8B0B8; margin-top: 6rpx; word-break: break-all; }
.or-agg-pills { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.or-mini { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: #F0F2F5; color: var(--c-sub); }
.or-mini--warn { background: #FFF6DD; color: #B98514; }
.or-mini--ok { background: #EAF9E8; color: var(--c-green-deep); }
.or-mini--mute { background: #F5F5F5; color: #A8B0B8; }

/* ---------------- 详情抽屉 ---------------- */
.or-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(40, 55, 70, 0.35);
  z-index: 90;
}
.or-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 86vh;
  background: var(--c-cream);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 91;
  display: flex;
  flex-direction: column;
}
.or-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 18rpx;
  border-bottom: 2rpx solid #F0EDE7;
}
.or-drawer-title { font-size: 32rpx; font-weight: 800; flex: 1; }
.or-drawer-close { font-size: 34rpx; color: var(--c-sub); padding-left: 20rpx; }
.or-drawer-body { padding: 8rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }

.or-dsec {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-top: 18rpx;
}
.or-drow { display: flex; padding: 8rpx 0; }
.or-dk { width: 160rpx; font-size: 24rpx; color: var(--c-sub); flex-shrink: 0; }
.or-dv { flex: 1; font-size: 25rpx; line-height: 1.6; word-break: break-all; }

/* 只读时间线 */
.or-tl { display: flex; gap: 16rpx; padding: 14rpx 0; }
.or-tl-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--c-blue-deep);
  margin-top: 10rpx;
  flex-shrink: 0;
}
.or-tl-main { flex: 1; min-width: 0; }
.or-tl-title { font-size: 26rpx; font-weight: 700; }
.or-tl-by { font-size: 21rpx; font-weight: 400; color: var(--c-sub); margin-left: 8rpx; }

/* ---------------- 补润色（T22） ---------------- */
/* 按钮 + 一句口径说明竖排；说明复用 .or-tl-by 的字号，但要去掉它的左外边距，
   否则在竖排块里会缩进得莫名其妙。 */
.or-polish { margin-top: 12rpx; }
.or-polish .or-tl-by { display: block; margin: 8rpx 0 0 0; line-height: 1.6; }
.or-tl-time { font-size: 23rpx; color: var(--c-sub); margin-top: 4rpx; }
.or-tl-detail { font-size: 23rpx; color: #7A8794; margin-top: 6rpx; line-height: 1.6; word-break: break-all; }

.or-verdict {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--c-blue-deep);
  margin-bottom: 12rpx;
}
.or-comment { font-size: 26rpx; line-height: 1.75; }
.or-summary {
  font-size: 25rpx;
  line-height: 1.75;
  color: #5A6672;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #E8EDF2;
}
.or-actions { margin-top: 26rpx; }
