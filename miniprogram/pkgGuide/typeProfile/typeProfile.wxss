.page-wrap { padding: 24rpx 24rpx 60rpx; }

/* 头部 */
.tp-head { display: flex; align-items: center; height: 80rpx; }
.tp-back { font-size: 30rpx; color: #3FA9F5; width: 120rpx; }
.tp-title { flex: 1; text-align: center; font-size: 34rpx; font-weight: 800; color: #2A3340; }
.tp-spacer { width: 120rpx; }

/* 类型卡 */
.type-card { display: flex; align-items: center; gap: 18rpx; border-radius: 24rpx; padding: 26rpx 28rpx; margin-bottom: 20rpx; }
.tc-emoji { font-size: 56rpx; }
.tc-name { font-size: 32rpx; font-weight: 800; color: #2A3340; }

/* 卡片 */
.card { background: #fff; border-radius: 24rpx; padding: 26rpx 24rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 18rpx rgba(150,180,210,.16); }
.section-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 12rpx; }
.section-title { font-size: 29rpx; font-weight: 800; color: #2A3340; flex: 1; }
.entry-go { font-size: 26rpx; color: #3FA9F5; font-weight: 700; }
.empty-tip { font-size: 24rpx; color: #9AA5B1; padding: 16rpx 0; }

/* 表单行 */
.opt-row { padding: 14rpx 0; border-bottom: 1rpx solid #F0F3F7; }
.opt-row:last-child { border-bottom: none; }
.opt-row.col { display: flex; flex-direction: column; align-items: stretch; }
.opt-name { font-size: 27rpx; color: #3A4350; margin-bottom: 8rpx; }
.opt-input-full { background: #F6F9FC; border-radius: 16rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #2A3340; }
.muted { font-size: 22rpx; color: #9AA5B1; }

/* 能力维度 */
.dim-row { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; border-bottom: 1rpx solid #F2F5F8; }
.dim-name { flex: 1; background: #F6F9FC; border-radius: 14rpx; padding: 14rpx 18rpx; font-size: 27rpx; color: #2A3340; }
.level-box { display: flex; align-items: center; gap: 6rpx; background: #F2F5F9; border-radius: 24rpx; padding: 6rpx; }
.lv-btn { width: 52rpx; height: 52rpx; line-height: 50rpx; text-align: center; border-radius: 50%; background: #fff; color: #3FA9F5; font-size: 34rpx; font-weight: 800; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.lv-btn:active { background: #E8F5E9; }
.lv-val { min-width: 44rpx; text-align: center; font-size: 30rpx; font-weight: 800; color: #2A3340; }
.dim-del { width: 48rpx; height: 48rpx; line-height: 46rpx; text-align: center; color: #C0C8D2; font-size: 28rpx; }
.dim-note { margin-top: 10rpx; }

/* 错误模式 */
.err-row { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 0; border-bottom: 1rpx solid #F2F5F8; }
.err-dot { font-size: 28rpx; }
.err-text { flex: 1; font-size: 27rpx; color: #3A4350; }
.err-del { width: 48rpx; height: 48rpx; line-height: 46rpx; text-align: center; color: #C0C8D2; font-size: 28rpx; }

/* 保存 */
.tp-save { margin-top: 10rpx; }

/* 智能识别（粘贴提示词自动填入） */
.paste-tip { margin-bottom: 12rpx; line-height: 1.6; }
.paste-area {
  width: 100%; box-sizing: border-box; min-height: 180rpx;
  background: #F6F9FC; border-radius: 16rpx; padding: 18rpx 20rpx;
  font-size: 26rpx; line-height: 1.6; color: #2A3340;
}
.paste-btn { margin-top: 16rpx; }
