.page { padding: 32rpx; }
.head { margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.sub { font-size: 26rpx; color: #6b7280; margin-top: 8rpx; line-height: 1.5; }
.form { background: #fff; border-radius: 20rpx; padding: 8rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.row:last-child { border-bottom: none; }
.label { font-size: 30rpx; color: #374151; }
.picker { font-size: 30rpx; color: #2563eb; }
.err { color: #dc2626; font-size: 26rpx; margin: 20rpx 4rpx; }
.gen-btn { margin-top: 40rpx; background: #2563eb; color: #fff; border-radius: 16rpx; font-size: 32rpx; }
.tip { font-size: 24rpx; color: #9ca3af; margin-top: 24rpx; text-align: center; }
