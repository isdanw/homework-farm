<view class="hub-page">

  <!-- ===== 锁定态（导学未启用） ===== -->
  <view wx:if="{{locked}}" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 64rpx;text-align:center;">
    <view style="font-size:96rpx;line-height:1;">🔒</view>
    <view style="margin-top:24rpx;font-size:38rpx;font-weight:800;color:#3A3A3A;">导学功能暂未启用</view>
    <view style="margin-top:16rpx;font-size:28rpx;color:#888;line-height:1.6;">
      <block wx:if="{{lockReason === 'no-child'}}">请先在「我的」添加孩子，才能使用导学功能。</block>
      <block wx:else>请先为孩子建立「成长计划」，才能使用导学功能。</block>
    </view>
    <view style="margin-top:48rpx;display:flex;flex-direction:column;gap:20rpx;width:100%;">
      <view wx:if="{{lockReason === 'no-child'}}" style="background:#5FBF6B;color:#fff;font-size:30rpx;font-weight:700;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="goMine">去添加孩子</view>
      <view wx:else style="background:#5FBF6B;color:#fff;font-size:30rpx;font-weight:700;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="goPlanFromHub">去建立计划</view>
      <view style="background:#fff;color:#666;border:3rpx solid #E2E2E2;font-size:30rpx;font-weight:600;padding:24rpx 0;border-radius:999rpx;text-align:center;" bindtap="goMine">返回「我的」</view>
    </view>
  </view>

  <!-- ===== 正常态 ===== -->
  <block wx:else>

  <!-- ===== 概览卡 ===== -->
  <view class="hub-overview">
    <view class="hub-ov-item">
      <view class="hub-ov-num">{{overview.sessions}}</view>
      <view class="hub-ov-name">导学归档</view>
    </view>
    <view class="hub-ov-item">
      <view class="hub-ov-num">{{overview.mistakes}}</view>
      <view class="hub-ov-name">错题总数</view>
    </view>
    <view class="hub-ov-item">
      <view class="hub-ov-num warn">{{overview.pending}}</view>
      <view class="hub-ov-name">待订正</view>
    </view>
    <view class="hub-ov-item">
      <view class="hub-ov-num ok">{{overview.evidence}}</view>
      <view class="hub-ov-name">已验证</view>
    </view>
  </view>

  <!-- ===== 主入口：AI 导学 ===== -->
  <view class="hub-card hub-main" bindtap="goTutor">
    <view class="hub-ic">💡</view>
    <view class="hub-body">
      <view class="hub-title">导学助手</view>
      <view class="hub-desc">不会的题发给我，一步步引导孩子自己想出来，不直接给答案</view>
    </view>
    <view class="hub-go">去提问 ›</view>
  </view>

  <!-- ===== 错题本（含订正 + 复测巩固） ===== -->
  <view class="hub-card" bindtap="goMistakes">
    <view class="hub-ic">📝</view>
    <view class="hub-body">
      <view class="hub-title">错题本</view>
      <view class="hub-desc">导学结束自动归因错因（E1-E9），在这里订正、复测巩固</view>
    </view>
    <view wx:if="{{overview.pending}}" class="hub-badge">待订正 {{overview.pending}}</view>
    <view class="hub-go">›</view>
  </view>

  <!-- ===== 导学报告（错因分布 + 复测证据） ===== -->
  <view class="hub-card" bindtap="goReport">
    <view class="hub-ic">📊</view>
    <view class="hub-body">
      <view class="hub-title">导学报告</view>
      <view class="hub-desc">错因分布 + 复测证据，复测达标（≥5 题且 ≥80%）才算过关</view>
    </view>
    <view wx:if="{{overview.evidence}}" class="hub-badge ok">已验证 {{overview.evidence}}</view>
    <view class="hub-go">›</view>
  </view>

  <!-- ===== 试卷库（F-B：工作台推送的真题 / 测验卷，只读） ===== -->
  <view class="hub-card" bindtap="goExam">
    <view class="hub-ic">📚</view>
    <view class="hub-body">
      <view class="hub-title">试卷库</view>
      <view class="hub-desc">由「全科导学工作台」推送的真题 / 测验卷，按学科浏览卷面与解析</view>
    </view>
    <view class="hub-go">›</view>
  </view>

  </block>

</view>
