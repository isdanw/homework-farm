<!-- 自定义底部导航：3 栏，图标全部 CSS 手绘，无需图片资源 -->
<view class="tabbar">
  <view
    class="tab {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="text"
    data-index="{{index}}"
    bindtap="switchTab">

    <view class="ic-box">
      <!-- 作业打卡：对勾 -->
      <view wx:if="{{item.icon === 'check'}}" class="ic ic-check">
        <view class="tick"></view>
      </view>
      <!-- 成长乐园：蓝书 + 金星 -->
      <view wx:elif="{{item.icon === 'learn'}}" class="ic ic-learn">
        <view class="bb"></view><view class="pg"></view><view class="st"></view>
      </view>
      <!-- 我的农场：小苗 -->
      <view wx:elif="{{item.icon === 'farm'}}" class="ic ic-farm">
        <view class="soil"></view>
        <view class="stem"></view>
        <view class="leaf l"></view>
        <view class="leaf r"></view>
      </view>
      <!-- 我的：小人 -->
      <view wx:else class="ic ic-mine">
        <view class="head"></view>
        <view class="body"></view>
      </view>

      <!-- 农场红点：今天还有作业没完成 -->
      <view wx:if="{{item.icon === 'farm' && warn}}" class="dot-warn">!</view>
    </view>

    <view class="tab-txt">{{item.text}}</view>
  </view>
</view>
