/* 自定义底部导航样式：加大点击区（每格高 ≥ 100rpx ≈ 50px），适配 iPhone 安全区 */
.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 800;
  display: flex; align-items: flex-start;
  background: #fff;
  border-top: 2rpx solid #EAF2F8;
  box-shadow: 0 -6rpx 20rpx rgba(150, 180, 210, .12);
  padding: 12rpx 0 calc(10rpx + env(safe-area-inset-bottom)) 0;
}
.tab {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; min-height: 100rpx; padding-top: 6rpx;
}
.tab-txt { font-size: 22rpx; color: #9AA5B1; margin-top: 6rpx; font-weight: 600; }
.tab.on .tab-txt { color: #3FA9F5; }
.tab.on .ic-box { transform: translateY(-4rpx) scale(1.08); }
.ic-box { position: relative; width: 56rpx; height: 52rpx; transition: transform .2s; }
.ic { position: absolute; inset: 0; }

/* —— 对勾 —— */
.ic-check { border: 4rpx solid #C6D3DE; border-radius: 50%; }
.tab.on .ic-check { border-color: #5FBF6B; }
.ic-check .tick {
  position: absolute; left: 14rpx; top: 10rpx; width: 14rpx; height: 24rpx;
  border-right: 5rpx solid #C6D3DE; border-bottom: 5rpx solid #C6D3DE;
  transform: rotate(42deg);
}
.tab.on .ic-check .tick { border-color: #5FBF6B; }

/* —— 小苗 —— */
.ic-farm .soil { position: absolute; bottom: 2rpx; left: 6rpx; right: 6rpx; height: 12rpx; border-radius: 8rpx; background: #D9C1A3; }
.ic-farm .stem { position: absolute; bottom: 12rpx; left: 25rpx; width: 5rpx; height: 22rpx; background: #6FCF7C; border-radius: 3rpx; }
.ic-farm .leaf { position: absolute; bottom: 26rpx; width: 18rpx; height: 12rpx; background: #A8E6A1; }
.ic-farm .leaf.l { left: 8rpx; border-radius: 12rpx 0 12rpx 0; }
.ic-farm .leaf.r { right: 8rpx; border-radius: 0 12rpx 0 12rpx; }
.tab.on .ic-farm .leaf { background: #6FCF7C; }

/* —— 学习乐园：蓝书 + 金星 —— */
.ic-learn { background: linear-gradient(135deg,#7FD4FF,#2BB0F0); border-radius: 12rpx; }
.ic-learn .bb { position: absolute; left: 9rpx; right: 9rpx; top: 13rpx; bottom: 11rpx; border-radius: 6rpx 12rpx 12rpx 6rpx; background: #fff; }
.ic-learn .pg { position: absolute; left: 25rpx; top: 13rpx; bottom: 11rpx; width: 4rpx; background: #2BB0F0; }
.ic-learn .st { position: absolute; right: 5rpx; top: 2rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #FFD86B; box-shadow: 0 0 0 3rpx #fff; }
.tab.on .ic-learn { background: linear-gradient(135deg,#9AD5FF,#2BB0F0); }

/* —— 我的：小人 —— */
.ic-mine .head { position: absolute; top: 4rpx; left: 50%; transform: translateX(-50%); width: 18rpx; height: 18rpx; border-radius: 50%; background: #C6D3DE; }
.ic-mine .body { position: absolute; bottom: 4rpx; left: 50%; transform: translateX(-50%); width: 34rpx; height: 22rpx; border-radius: 18rpx 18rpx 0 0; background: #C6D3DE; }
.tab.on .ic-mine .head,
.tab.on .ic-mine .body { background: #3FA9F5; }

/* 红点警告 */
.dot-warn {
  position: absolute; right: -8rpx; top: -8rpx;
  min-width: 30rpx; height: 30rpx; border-radius: 15rpx;
  background: #FF7A7A; color: #fff; font-size: 22rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 0 4rpx #fff;
  animation: warnPulse 1.2s infinite;
}
@keyframes warnPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}
