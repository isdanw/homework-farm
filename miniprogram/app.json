{
  "pages": [
    "pages/index/index",
    "pages/checkin/checkin",
    "pages/farm/farm",
    "pages/mine/mine"
  ],
  "subpackages": [
    {
      "root": "pkgGuide",
      "name": "guide",
      "pages": [
        "tutor/tutor",
        "tutorHub/tutorHub",
        "report/report",
        "retest/retest",
        "learnerProfile/learnerProfile",
        "typeProfile/typeProfile",
        "examGallery/examGallery"
      ]
    },
    {
      "root": "pkgTools",
      "name": "tools",
      "pages": [
        "schedule/schedule",
        "mistakes/mistakes",
        "mistakes/confirm/confirm",
        "plan/plan",
        "webportal/webportal",
        "typeManage/typeManage",
