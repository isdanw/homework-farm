    "color": "#9AA5B1",
    "selectedColor": "#3FA9F5",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "成长乐园"
      },
      {
        "pagePath": "pages/checkin/checkin",
        "text": "每日打卡"
      },
      {
        "pagePath": "pages/farm/farm",
        "text": "我的农场"
      },
      {
