/* 作业打卡页样式 */

/* ---- 今晚预告条 ---- */
.forecast {
  display: flex; align-items: center; gap: 18rpx;
  border-radius: 28rpx; padding: 22rpx 24rpx; margin-bottom: 24rpx;
}
.forecast.good { background: linear-gradient(135deg,#EAF7FF,#EFFBEF); }
.forecast.bad { background: linear-gradient(135deg,#FFEFF2,#FFF6E3); border: 3rpx solid #FFC9D2; }
.fx-text { flex: 1; font-size: 28rpx; line-height: 1.5; font-weight: 600; }
.forecast.bad .fx-text { color: #E0475C; }
.fx-icon { width: 90rpx; height: 90rpx; position: relative; flex-shrink: 0; }

.mini-sun {
  width: 76rpx; height: 76rpx; border-radius: 50%; margin: 7rpx;
  background: radial-gradient(circle at 35% 30%, #FFF3B0, #FFC94D);
  box-shadow: 0 0 0 10rpx rgba(255,201,77,.25);
  animation: spinSlow 8s linear infinite;
}
@keyframes spinSlow { to { transform: rotate(360deg); } }

/* 迷你小狗熊头（预警用） */
.mini-bear { position: absolute; inset: 8rpx; animation: shakeHead 1.4s ease-in-out infinite; }
.mini-bear .ear {
  position: absolute; top: 0; width: 26rpx; height: 26rpx; border-radius: 50%;
  background: #A9764F; border: 4rpx solid #8B5E34; box-sizing: border-box;
}
.mini-bear .ear.l { left: 2rpx; } .mini-bear .ear.r { right: 2rpx; }
.mini-bear .face {
  position: absolute; left: 6rpx; right: 6rpx; top: 14rpx; bottom: 4rpx;
  background: #C89B6E; border-radius: 50%;
  border: 4rpx solid #8B5E34; box-sizing: border-box;
}
.mini-bear .eye { position: absolute; top: 16rpx; width: 8rpx; height: 10rpx; border-radius: 5rpx; background: #4A2F16; }
.mini-bear .eye.l { left: 14rpx; } .mini-bear .eye.r { right: 14rpx; }
.mini-bear .nose { position: absolute; left: 50%; margin-left: -8rpx; top: 30rpx; width: 16rpx; height: 12rpx; border-radius: 8rpx; background: #4A2F16; }
@keyframes shakeHead {
  0%,100% { transform: rotate(-6deg); }
  50% { transform: rotate(6deg); }
}

/* ---- 用时选择 ---- */
.min-row { display: flex; gap: 14rpx; margin-bottom: 14rpx; }
.min-chip {
  flex: 1; min-height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 20rpx; background: #F2F6FA; font-size: 28rpx; font-weight: 700; color: #7A8792;
}
.min-chip.on { background: #BFE6FF; color: #1E7BC0; }

/* ---- 三科卡片 ---- */
.hw-card { border: 4rpx solid #F0F5F9; }
.hw-card.done { border-color: #C7EFC4; background: #FAFFFA; }
.hw-top { display: flex; align-items: center; gap: 20rpx; }
.sub-badge.big { width: 96rpx; height: 96rpx; font-size: 46rpx; border-radius: 32rpx; }
.hw-info { flex: 1; min-width: 0; }
.hw-name { font-size: 38rpx; font-weight: 800; }
.hw-state { font-size: 26rpx; color: #6FCF7C; font-weight: 600; }
.hw-state.warn { color: #9AA5B1; font-weight: 500; }
.hw-note { margin-top: 16rpx; background: #F7FAFD; border-radius: 18rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: #6A6A6A; }
.hw-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.big-btn { min-height: 104rpx; font-size: 38rpx; border-radius: 52rpx; }

/* ---- 近 7 天 ---- */
.week-row { display: flex; justify-content: space-between; align-items: flex-end; }
.wk { flex: 1; text-align: center; }
.wk-bars { display: flex; flex-direction: column-reverse; gap: 6rpx; align-items: center; margin-bottom: 10rpx; }
.wk-b { width: 34rpx; height: 22rpx; border-radius: 8rpx; background: #EDF3F8; }
.wk-b.f { background: linear-gradient(180deg,#A8E6A1,#5FBF6B); }
.wk-d { font-size: 22rpx; color: #9AA5B1; }
.wk-d.today { color: #3FA9F5; font-weight: 800; }

/* ---- 奖励弹窗 ---- */
.reward-dialog { overflow: visible; }
.rw-burst { position: relative; width: 200rpx; height: 200rpx; margin: -20rpx auto 10rpx; }
.rw-sun {
  position: absolute; left: 50rpx; top: 50rpx; width: 100rpx; height: 100rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFF6C4, #FFC94D);
  box-shadow: 0 0 40rpx rgba(255,201,77,.6);
  animation: popIn .5s cubic-bezier(.2,1.6,.5,1);
}
.ray {
  position: absolute; left: 96rpx; top: 10rpx; width: 8rpx; height: 34rpx; border-radius: 4rpx;
  background: #FFD979; transform-origin: 4rpx 90rpx;
  animation: rayGrow .6s ease-out;
}
@keyframes popIn { 0% { transform: scale(.2); } 100% { transform: scale(1); } }
@keyframes rayGrow { 0% { opacity: 0; height: 0; } 100% { opacity: 1; height: 34rpx; } }

.gain-row { display: flex; flex-wrap: wrap; gap: 14rpx; justify-content: center; margin: 20rpx 0 10rpx; }
.gain {
  display: flex; align-items: center; gap: 10rpx;
  background: #FFF7E4; border-radius: 30rpx; padding: 12rpx 24rpx;
  font-size: 30rpx; font-weight: 700; color: #A9761A;
}
