/* 金币商城样式 */
.mall-page { padding-bottom: 60rpx; }

/* 头像卡 */
.me-card {
  display: flex; align-items: center; gap: 20rpx;
  background: linear-gradient(135deg,#FFF7E0,#FFEFF4);
  border-radius: 32rpx; padding: 26rpx; margin-bottom: 24rpx;
}
.avatar-box {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #fff; padding: 8rpx; box-sizing: border-box; position: relative;
}
/* 头像框效果 */
.avatar-box.frame-flower { box-shadow: 0 0 0 8rpx #FFC9DC, 0 0 0 12rpx #FF8FAE; }
.avatar-box.frame-star { box-shadow: 0 0 0 8rpx #BFE6FF, 0 0 0 12rpx #3FA9F5; }
.avatar { position: relative; width: 100%; height: 100%; border-radius: 50%; background: #FFE3CE; overflow: hidden; }
.a-hair { position: absolute; top: 0; left: 8rpx; right: 8rpx; height: 42rpx; border-radius: 0 0 40rpx 40rpx; background: #6B4A32; }
.a-face { position: absolute; inset: 0; }
.a-eye { position: absolute; top: 56rpx; width: 10rpx; height: 14rpx; border-radius: 6rpx; background: #4A2F16; }
.a-eye.l { left: 30rpx; } .a-eye.r { right: 30rpx; }
.a-cheek { position: absolute; top: 70rpx; width: 16rpx; height: 10rpx; border-radius: 8rpx; background: #FFB3C6; }
.a-cheek.l { left: 16rpx; } .a-cheek.r { right: 16rpx; }
.a-smile { position: absolute; left: 44rpx; top: 74rpx; width: 20rpx; height: 10rpx; border-bottom: 4rpx solid #C9765C; border-radius: 0 0 20rpx 20rpx; }
.me-info { flex: 1; }
.me-name { font-size: 34rpx; font-weight: 800; }
.me-sub { font-size: 25rpx; color: #8A8A8A; }
.me-coin { display: flex; align-items: center; gap: 10rpx; font-size: 34rpx; font-weight: 800; color: #F5B740; }

/* 分类 tab */
.mtabs { display: flex; gap: 14rpx; margin-bottom: 22rpx; }
.mt {
  flex: 1; min-height: 84rpx; line-height: 84rpx; text-align: center;
  background: #fff; border-radius: 22rpx; font-size: 29rpx; font-weight: 700; color: #7A8792;
  box-shadow: 0 4rpx 14rpx rgba(150,180,210,.12);
}
.mt.on { background: linear-gradient(180deg,#FFE29A,#F5C860); color: #7A4E00; }

/* 商品行 */
.m-row { display: flex; align-items: center; gap: 18rpx; }
.m-prev { width: 110rpx; height: 110rpx; flex-shrink: 0; }
.pv-cert { width: 100%; height: 100%; border: 5rpx solid; border-radius: 14rpx; background: #FFFDF6; padding: 12rpx; box-sizing: border-box; }
.pc-ribbon { width: 40rpx; height: 14rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.pc-line { height: 8rpx; background: #E8E2D4; border-radius: 4rpx; margin-bottom: 8rpx; }
.pc-line.short { width: 60%; }
.pv-frame { width: 100%; height: 100%; border: 8rpx solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.pf-dot { width: 44rpx; height: 44rpx; border-radius: 50%; opacity: .5; }
.pv-skin { width: 100%; height: 100%; border-radius: 20rpx; }

.m-main { flex: 1; min-width: 0; }
.m-name { font-size: 32rpx; font-weight: 800; }
.m-desc { font-size: 24rpx; color: #8A8A8A; line-height: 1.4; }
.m-price { display: flex; align-items: center; gap: 8rpx; font-size: 27rpx; font-weight: 700; color: #F5B740; margin-top: 6rpx; }

.tip-card .tip-line { font-size: 26rpx; color: #6A6A6A; line-height: 1.8; }
.tip-card .tip-line.danger { color: #E0475C; font-weight: 700; }

/* 奖状 */
.cert-paper {
  position: relative; width: 100%; max-width: 640rpx;
  background: #FFFDF6; border: 10rpx solid #FFD98E; border-radius: 20rpx;
  padding: 40rpx 36rpx 32rpx; text-align: center;
  animation: pop .3s cubic-bezier(.2,1.3,.5,1);
}
.cp-top { height: 12rpx; border-radius: 8rpx; width: 40%; margin: 0 auto 20rpx; }
.cp-title { font-size: 52rpx; font-weight: 800; letter-spacing: 10rpx; color: #C0392B; }
.cp-name { font-size: 36rpx; font-weight: 800; margin: 24rpx 0 16rpx; }
.cp-body { font-size: 28rpx; line-height: 2; text-align: left; text-indent: 2em; color: #4A4A4A; }
.cp-foot { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 30rpx; }
.cp-award { font-size: 26rpx; color: #A9761A; font-weight: 700; }
.cp-date { font-size: 26rpx; color: #8A8A8A; }
.cp-seal {
  position: absolute; right: 44rpx; bottom: 90rpx;
  width: 110rpx; height: 110rpx; border-radius: 50%;
  border: 6rpx solid rgba(192,57,43,.75); color: rgba(192,57,43,.85);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 800; transform: rotate(-16deg);
}
.cp-close { margin-top: 26rpx; }
