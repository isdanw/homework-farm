/* 学习统计页样式 */
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.g-card {
  width: calc(50% - 10rpx); box-sizing: border-box;
  border-radius: 28rpx; padding: 26rpx; text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(150,180,210,.14);
}
.g-blue { background: linear-gradient(135deg,#E6F5FF,#CFEBFF); }
.g-green { background: linear-gradient(135deg,#EEFBEE,#D8F5D6); }
.g-yellow { background: linear-gradient(135deg,#FFF7E0,#FFEBBF); }
.g-pink { background: linear-gradient(135deg,#FFEFF3,#FFDCE5); }
.g-num { font-size: 56rpx; font-weight: 800; line-height: 1.2; }
.g-lab { font-size: 25rpx; color: #7A8792; }

/* 柱状图 */
.chart {
  display: flex; align-items: flex-end; justify-content: space-between;
  height: 240rpx; padding: 10rpx 0 0;
}
.ch-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.ch-bar {
  width: 26rpx; border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg,#BFE6FF,#7FC9F5);
  transition: height .5s ease;
}
.ch-bar.full { background: linear-gradient(180deg,#A8E6A1,#5FBF6B); }
.ch-bar.zero { background: #FFD2D2; }
.ch-lab { font-size: 20rpx; color: #9AA5B1; margin-top: 8rpx; }
.ch-lab.today { color: #3FA9F5; font-weight: 800; }
.legend { display: flex; gap: 24rpx; margin-top: 16rpx; }
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #8A8A8A; }
.lg .box { width: 20rpx; height: 20rpx; border-radius: 6rpx; background: #7FC9F5; }
.lg .box.full { background: #5FBF6B; }
.lg .box.zero { background: #FFD2D2; }

/* 完成率 */
.rate-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.rt-name { width: 90rpx; font-size: 30rpx; font-weight: 700; }
.rt-bar { flex: 1; }
.rt-num { width: 90rpx; text-align: right; font-size: 28rpx; font-weight: 700; color: #6A6A6A; }

/* 大事记 */
.log { padding: 16rpx 20rpx; border-radius: 18rpx; margin-bottom: 14rpx; background: #F7FAFD; }
.log.punish { background: #FFF0F2; }
.log.reward { background: #FFFAE9; }
.log.fix { background: #EEFBEE; }
.log.shield { background: #EAF6FF; }
.lg-date { font-size: 22rpx; color: #9AA5B1; }
.lg-text { font-size: 27rpx; line-height: 1.5; }
